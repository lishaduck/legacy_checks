{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "assigneesFromCodeOwners": true,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["actions/**"]
    }
  ]
}
